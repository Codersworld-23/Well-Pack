# WellPack backend configuration.
# Every value has a working default - copy to .env only to override.

# --- storage ---
# SQLite by default. Point at PostgreSQL for a shared deployment:
# DATABASE_URL=postgresql+psycopg://wellpack:secret@localhost:5432/wellpack
# UPLOAD_DIR=./uploads

# --- RAG-grounded LLM compliance decision ---
# Clauses retrieved from the ingested PDFs are included in every decision prompt.
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://aicredits.in/v1
# Low-cost default; override with a model enabled by your provider.
# OPENAI_MODEL=gpt-4o-mini
# LLM_TIMEOUT_SECONDS=45

# --- RAG / vector store ---
# Set to move the clause index from the in-process store to Pinecone.
# PINECONE_API_KEY=
# PINECONE_INDEX=wellpack-legal-metrology
# EMBEDDING_DIM=768
# RETRIEVAL_TOP_K=5

# --- semantic cache ---
# REDIS_URL=redis://localhost:6379/0
# CACHE_THRESHOLD=0.94        # cosine similarity required for a cache hit
# CACHE_TTL=86400

# --- vision thresholds ---
# BLUR_THRESHOLD=55.0         # Laplacian variance below this prompts a retake
# GLARE_THRESHOLD=0.055       # share of the frame lost to specular blobs
# MIN_CONTRAST_RATIO=3.0      # Rule 9(1) conspicuousness floor
# PACKAGE_WIDTH_MM=90.0       # assumed width of the captured face, for px->mm

# --- auth ---
# Required for any real deployment. Left unset, the server generates a random
# key at startup, so tokens are unforgeable but do not survive a restart.
# JWT_SECRET=
# JWT_TTL_HOURS=12

# --- CORS ---
# CORS_ORIGINS=http://localhost:3000
